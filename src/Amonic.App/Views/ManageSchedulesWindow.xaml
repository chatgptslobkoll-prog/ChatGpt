<Window x:Class="Amonic.App.Views.ManageSchedulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Flight Schedules"
        WindowStartupLocation="CenterScreen"
        Height="580" Width="1080">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Width="150" Margin="0,0,8,0" Content="Search" Click="Search_Click"/>
            <Button Width="150" Margin="0,0,8,0" Content="Import changes" Click="Import_Click"/>
            <Button Width="150" Margin="0,0,8,0" Content="Edit selected" Click="Edit_Click"/>
            <Button Width="150" Content="Confirm/Cancel" Click="Toggle_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="From:" Margin="0,0,6,0"/><ComboBox x:Name="FromComboBox" Width="120" Margin="0,0,8,0" DisplayMemberPath="IATACode" SelectedValuePath="ID"/>
            <TextBlock VerticalAlignment="Center" Text="To:" Margin="0,0,6,0"/><ComboBox x:Name="ToComboBox" Width="120" Margin="0,0,8,0" DisplayMemberPath="IATACode" SelectedValuePath="ID"/>
            <TextBlock VerticalAlignment="Center" Text="Date:" Margin="0,0,6,0"/><DatePicker x:Name="DatePicker" Width="140" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Text="Flight #:" Margin="0,0,6,0"/><TextBox x:Name="FlightNoTextBox" Width="100" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Text="Sort by:" Margin="0,0,6,0"/>
            <ComboBox x:Name="SortComboBox" Width="150"><ComboBoxItem Content="Date and Time" IsSelected="True"/><ComboBoxItem Content="Economy Price"/><ComboBoxItem Content="Confirmed"/></ComboBox>
        </StackPanel>

        <DataGrid x:Name="SchedulesDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="100" Binding="{Binding Date}"/>
                <DataGridTextColumn Header="Time" Width="90" Binding="{Binding Time}"/>
                <DataGridTextColumn Header="From" Width="80" Binding="{Binding From}"/>
                <DataGridTextColumn Header="To" Width="80" Binding="{Binding To}"/>
                <DataGridTextColumn Header="Flight #" Width="100" Binding="{Binding FlightNumber}"/>
                <DataGridTextColumn Header="Aircraft" Width="130" Binding="{Binding Aircraft}"/>
                <DataGridTextColumn Header="Economy" Width="100" Binding="{Binding Economy}"/>
                <DataGridTextColumn Header="Business" Width="100" Binding="{Binding Business}"/>
                <DataGridTextColumn Header="First" Width="100" Binding="{Binding First}"/>
                <DataGridCheckBoxColumn Header="Confirmed" Width="90" Binding="{Binding Confirmed}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
