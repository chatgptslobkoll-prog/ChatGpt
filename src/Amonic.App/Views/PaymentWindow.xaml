<Window x:Class="Amonic.App.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение оплаты"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Height="340" Width="460">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <TextBlock FontSize="18" FontWeight="Bold" Text="Оплата" Margin="0,0,0,12"/>
        <TextBlock x:Name="TotalAmountTextBlock" Grid.Row="1" Margin="0,4"/>

        <GroupBox Grid.Row="2" Header="Способ оплаты" Margin="0,8,0,0">
            <StackPanel Margin="8">
                <RadioButton Content="Банковская карта" IsChecked="True"/>
                <RadioButton Content="Наличные"/>
                <RadioButton Content="Ваучер"/>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Foreground="Firebrick" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0">
            <Button Width="130" Margin="0,0,8,0" Content="Выпустить билеты" Click="Issue_Click"/>
            <Button Width="130" Background="IndianRed" Foreground="White" Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
