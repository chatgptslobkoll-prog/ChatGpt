<Window x:Class="Amonic.App.Views.FlightSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск рейсов"
        WindowStartupLocation="CenterScreen"
        Height="640" Width="1120">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Text="Откуда:" Margin="0,0,6,0"/><ComboBox x:Name="FromComboBox" Width="110" Margin="0,0,10,0" DisplayMemberPath="IATACode" SelectedValuePath="ID"/>
            <TextBlock VerticalAlignment="Center" Text="Куда:" Margin="0,0,6,0"/><ComboBox x:Name="ToComboBox" Width="110" Margin="0,0,10,0" DisplayMemberPath="IATACode" SelectedValuePath="ID"/>
            <TextBlock VerticalAlignment="Center" Text="Туда:" Margin="0,0,6,0"/><DatePicker x:Name="OutboundDatePicker" Width="130" Margin="0,0,10,0"/>
            <TextBlock VerticalAlignment="Center" Text="Обратно:" Margin="0,0,6,0"/><DatePicker x:Name="ReturnDatePicker" Width="130" Margin="0,0,10,0"/>
            <ComboBox x:Name="CabinComboBox" Width="130" Margin="0,0,10,0"><ComboBoxItem Content="Эконом" Tag="1" IsSelected="True"/><ComboBoxItem Content="Бизнес" Tag="2"/><ComboBoxItem Content="Первый" Tag="3"/></ComboBox>
            <RadioButton x:Name="OneWayRadioButton" Content="В одну сторону" Margin="0,0,8,0" IsChecked="True"/>
            <RadioButton x:Name="RoundTripRadioButton" Content="Туда-обратно" Margin="0,0,10,0"/>
            <Button Width="90" Content="Поиск" Click="Search_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock FontWeight="Bold" Text="Рейсы туда"/>
            <CheckBox x:Name="OutboundAroundDaysCheckBox" Margin="0,4,0,4" Content="±3 дня"/>
            <DataGrid x:Name="OutboundDataGrid" Height="210" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Откуда" Binding="{Binding From}" Width="80"/>
                    <DataGridTextColumn Header="Куда" Binding="{Binding To}" Width="80"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="90"/>
                    <DataGridTextColumn Header="Рейсы" Binding="{Binding Flights}" Width="2*"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                    <DataGridTextColumn Header="Свободно" Binding="{Binding FreeSeats}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock FontWeight="Bold" Margin="0,10,0,0" Text="Обратные рейсы"/>
            <CheckBox x:Name="ReturnAroundDaysCheckBox" Margin="0,4,0,4" Content="±3 дня"/>
            <DataGrid x:Name="ReturnDataGrid" Height="210" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Откуда" Binding="{Binding From}" Width="80"/>
                    <DataGridTextColumn Header="Куда" Binding="{Binding To}" Width="80"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="90"/>
                    <DataGridTextColumn Header="Рейсы" Binding="{Binding Flights}" Width="2*"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                    <DataGridTextColumn Header="Свободно" Binding="{Binding FreeSeats}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <TextBlock VerticalAlignment="Center" Text="Пассажиры:" Margin="0,0,6,0"/>
                <TextBox x:Name="PassengersTextBox" Width="60" Text="1" Margin="0,0,10,0"/>
                <Button Width="180" Content="Забронировать выбранные рейсы" Click="Book_Click"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
