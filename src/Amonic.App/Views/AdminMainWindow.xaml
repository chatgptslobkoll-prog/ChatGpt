<Window x:Class="Amonic.App.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Main Menu"
        WindowStartupLocation="CenterScreen"
        Height="520" Width="900">
    <DockPanel Margin="12">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Add user" Click="AddUser_Click" />
            <MenuItem Header="Exit" Click="Exit_Click" />
        </Menu>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="130" Margin="0,0,8,0" Content="Change Role" Click="ChangeRole_Click"/>
            <Button Width="130" Margin="0,0,8,0" Content="Block/Unblock" Click="ToggleBlock_Click"/>
            <Button Width="130" Background="IndianRed" Foreground="White" Content="Close" Click="Exit_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock FontSize="18" FontWeight="Bold" Text="Users Management" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center" Text="Office:" Margin="0,0,8,0"/>
                <ComboBox Width="220">
                    <ComboBoxItem Content="All Offices" IsSelected="True"/>
                    <ComboBoxItem Content="Abu Dhabi"/>
                    <ComboBoxItem Content="Doha"/>
                    <ComboBoxItem Content="Cairo"/>
                </ComboBox>
            </StackPanel>
            <DataGrid AutoGenerateColumns="False" Height="360">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="First Name" Width="*" Binding="{Binding FirstName}"/>
                    <DataGridTextColumn Header="Last Name" Width="*" Binding="{Binding LastName}"/>
                    <DataGridTextColumn Header="Age" Width="80" Binding="{Binding Age}"/>
                    <DataGridTextColumn Header="Role" Width="140" Binding="{Binding Role}"/>
                    <DataGridTextColumn Header="Email" Width="2*" Binding="{Binding Email}"/>
                    <DataGridTextColumn Header="Office" Width="140" Binding="{Binding Office}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>
