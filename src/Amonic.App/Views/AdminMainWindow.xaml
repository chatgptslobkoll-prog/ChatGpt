<Window x:Class="Amonic.App.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Главное меню администратора"
        WindowStartupLocation="CenterScreen"
        Height="560" Width="980">
    <DockPanel Margin="12">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Добавить пользователя" Click="AddUser_Click" />
            <MenuItem Header="Управление расписанием" Click="ManageSchedules_Click" />
            <MenuItem Header="Бронирование" Click="BookTickets_Click" />
            <MenuItem Header="Выход" Click="Exit_Click" />
        </Menu>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="130" Margin="0,0,8,0" Content="Обновить" Click="Refresh_Click"/>
            <Button Width="130" Margin="0,0,8,0" Content="Сменить роль" Click="ChangeRole_Click"/>
            <Button Width="130" Margin="0,0,8,0" Content="Блок/Разблок" Click="ToggleBlock_Click"/>
            <Button Width="130" Background="IndianRed" Foreground="White" Content="Закрыть" Click="Exit_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock FontSize="18" FontWeight="Bold" Text="Управление пользователями" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center" Text="Офис:" Margin="0,0,8,0"/>
                <ComboBox x:Name="OfficeComboBox" Width="220" DisplayMemberPath="Title" SelectedValuePath="ID" SelectionChanged="OfficeComboBox_SelectionChanged"/>
            </StackPanel>
            <DataGrid x:Name="UsersDataGrid" AutoGenerateColumns="False" Height="390" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Width="50" Binding="{Binding ID}"/>
                    <DataGridTextColumn Header="Имя" Width="*" Binding="{Binding FirstName}"/>
                    <DataGridTextColumn Header="Фамилия" Width="*" Binding="{Binding LastName}"/>
                    <DataGridTextColumn Header="Возраст" Width="80" Binding="{Binding Age}"/>
                    <DataGridTextColumn Header="Роль" Width="140" Binding="{Binding Role}"/>
                    <DataGridTextColumn Header="Email" Width="2*" Binding="{Binding Email}"/>
                    <DataGridTextColumn Header="Офис" Width="140" Binding="{Binding Office}"/>
                    <DataGridCheckBoxColumn Header="Активен" Width="70" Binding="{Binding Active}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>
