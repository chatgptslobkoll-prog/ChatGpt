<Window x:Class="Amonic.App.Views.BookingConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booking Confirmation"
        WindowStartupLocation="CenterScreen"
        Height="640" Width="1020">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Confirm Booking"/>
            <TextBlock Text="Selected flights" Margin="0,4,0,8"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="120" Margin="0,0,8,0" Content="Remove" Click="RemovePassenger_Click"/>
            <Button Width="160" Margin="0,0,8,0" Content="Confirm booking" Click="Confirm_Click"/>
            <Button Width="160" Background="IndianRed" Foreground="White" Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DataGrid x:Name="RoutesDataGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="From" Width="80" Binding="{Binding From}"/>
                    <DataGridTextColumn Header="To" Width="80" Binding="{Binding To}"/>
                    <DataGridTextColumn Header="Date" Width="120" Binding="{Binding Date}"/>
                    <DataGridTextColumn Header="Time" Width="90" Binding="{Binding Time}"/>
                    <DataGridTextColumn Header="Flight #" Width="120" Binding="{Binding Flights}"/>
                    <DataGridTextColumn Header="Price" Width="120" Binding="{Binding Price}"/>
                    <DataGridTextColumn Header="Free Seats" Width="100" Binding="{Binding FreeSeats}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Passenger data" FontWeight="Bold"/>
                    <TextBox x:Name="FirstNameTextBox" Margin="0,5" ToolTip="First name"/>
                    <TextBox x:Name="LastNameTextBox" Margin="0,5" ToolTip="Last name"/>
                    <DatePicker x:Name="BirthdatePicker" Margin="0,5"/>
                    <TextBox x:Name="PassportTextBox" Margin="0,5" ToolTip="Passport number"/>
                    <ComboBox x:Name="CountryComboBox" Margin="0,5" DisplayMemberPath="Name" SelectedValuePath="ID"/>
                    <TextBox x:Name="PhoneTextBox" Margin="0,5" ToolTip="Phone"/>
                    <TextBox x:Name="EmailTextBox" Margin="0,5" ToolTip="Email"/>
                    <Button Width="150" Margin="0,8,0,0" Content="Add passenger" Click="AddPassenger_Click"/>
                    <TextBlock x:Name="ErrorTextBlock" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <DataGrid x:Name="PassengersDataGrid" Grid.Column="1" Margin="10,0,0,0" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="First" Binding="{Binding FirstName}" Width="*"/>
                        <DataGridTextColumn Header="Last" Binding="{Binding LastName}" Width="*"/>
                        <DataGridTextColumn Header="Passport" Binding="{Binding PassportNumber}" Width="120"/>
                        <DataGridTextColumn Header="CountryID" Binding="{Binding PassportCountryID}" Width="100"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
