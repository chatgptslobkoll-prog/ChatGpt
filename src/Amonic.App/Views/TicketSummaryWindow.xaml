<Window x:Class="Amonic.App.Views.TicketSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Билеты выпущены"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Height="360" Width="760">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Бронирование завершено"/>
        <TextBlock x:Name="BookingReferenceTextBlock" DockPanel.Dock="Top" Margin="0,6,0,10"/>
        <DataGrid x:Name="TicketsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Пассажир" Binding="{Binding Passenger}" Width="2*"/>
                <DataGridTextColumn Header="Рейс №" Binding="{Binding Flight}" Width="*"/>
                <DataGridTextColumn Header="Класс" Binding="{Binding Cabin}" Width="100"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button DockPanel.Dock="Bottom" Width="120" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0" Content="Закрыть" Click="Close_Click"/>
    </DockPanel>
</Window>
