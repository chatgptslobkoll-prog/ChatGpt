<Window x:Class="Amonic.App.Views.UserMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Main Menu"
        WindowStartupLocation="CenterScreen"
        Height="520" Width="920">
    <DockPanel Margin="12">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </Menu>

        <StackPanel>
            <TextBlock x:Name="WelcomeTextBlock" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="TimeTextBlock" Margin="0,8,0,0" />
            <TextBlock x:Name="CrashTextBlock" Margin="0,0,0,10" />

            <DataGrid x:Name="ActivityDataGrid" Height="380" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Login" Width="*" Binding="{Binding LoginAt}"/>
                    <DataGridTextColumn Header="Logout" Width="*" Binding="{Binding LogoutAt}"/>
                    <DataGridTextColumn Header="Duration" Width="120" Binding="{Binding Duration}"/>
                    <DataGridTextColumn Header="Crash reason" Width="2*" Binding="{Binding CrashReason}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>
