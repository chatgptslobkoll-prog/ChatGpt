<Window x:Class="Amonic.App.Views.UserMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Main Menu"
        WindowStartupLocation="CenterScreen"
        Height="500" Width="880">
    <DockPanel Margin="12">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </Menu>

        <StackPanel>
            <TextBlock FontSize="18" FontWeight="Bold" Text="Hi [fullname], Welcome to AMONIC Airlines Automation System" />
            <TextBlock Margin="0,8,0,0" Text="Time spent on system: [hh:mm:ss]" />
            <TextBlock Margin="0,0,0,10" Text="Number of crashes: [n]" />

            <DataGrid Height="360" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Login" Width="*" Binding="{Binding LoginAt}"/>
                    <DataGridTextColumn Header="Logout" Width="*" Binding="{Binding LogoutAt}"/>
                    <DataGridTextColumn Header="Duration" Width="120" Binding="{Binding Duration}"/>
                    <DataGridTextColumn Header="Crash reason" Width="2*" Binding="{Binding CrashReason}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>
