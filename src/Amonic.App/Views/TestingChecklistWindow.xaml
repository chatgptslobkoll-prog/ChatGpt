<Window x:Class="Amonic.App.Views.TestingChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чеклист тестирования"
        WindowStartupLocation="CenterScreen"
        Height="450" Width="820">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Сессия 3 - шаблон тестирования" Margin="0,0,0,8"/>
        <DataGrid AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Кейс" Width="80" Binding="{Binding Case}"/>
                <DataGridTextColumn Header="Сценарий" Width="3*" Binding="{Binding Scenario}"/>
                <DataGridTextColumn Header="Ожидаемо" Width="2*" Binding="{Binding Expected}"/>
                <DataGridTextColumn Header="Фактически" Width="2*" Binding="{Binding Actual}"/>
                <DataGridCheckBoxColumn Header="Успешно" Width="80" Binding="{Binding Passed}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
