<Window x:Class="Amonic.App.Views.TestingChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Testing Checklist"
        WindowStartupLocation="CenterScreen"
        Height="450" Width="820">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Session 3 - Testing Template" Margin="0,0,0,8"/>
        <DataGrid AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Case" Width="80" Binding="{Binding Case}"/>
                <DataGridTextColumn Header="Scenario" Width="3*" Binding="{Binding Scenario}"/>
                <DataGridTextColumn Header="Expected" Width="2*" Binding="{Binding Expected}"/>
                <DataGridTextColumn Header="Actual" Width="2*" Binding="{Binding Actual}"/>
                <DataGridCheckBoxColumn Header="Passed" Width="80" Binding="{Binding Passed}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
